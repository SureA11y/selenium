{
  "name": "@surea11y/selenium",
  "version": "1.5.0",
  "description": "Accessibility (a11y, WCAG) checks for Selenium WebDriver tests: scan the live page with new A11yCoreBuilder({ driver }).analyze() and get only proven violations, with findings that need human review listed separately.",
  "keywords": [
    "accessibility",
    "a11y",
    "a11y-testing",
    "wcag",
    "wcag21",
    "wcag22",
    "en301549",
    "en-301-549",
    "european-accessibility-act",
    "accessibility-testing",
    "selenium",
    "selenium-webdriver",
    "webdriver",
    "e2e",
    "e2e-testing",
    "end-to-end",
    "audit",
    "aria",
    "surea11y"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/selenium.git"
  },
  "homepage": "https://github.com/SureA11y/selenium#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/selenium/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^1.5.0",
    "@surea11y/core": "^1.12.0"
  },
  "peerDependencies": {
    "selenium-webdriver": ">=4.11.0"
  },
  "devDependencies": {
    "@types/selenium-webdriver": "^4.35.7",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "example": "node examples/basic-scan.js",
    "example:e2e": "node --test examples/e2e-test-example.test.js",
    "example:pack": "node examples/scan-with-pack.js"
  }
}
